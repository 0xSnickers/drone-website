# ==========================================================
# AeroApex (drone-website) 生产环境配置模板
# 复制到服务器私有路径：cp deploy/.env.prod.example /srv/drone-website/.env.prod
# ==========================================================

# ---------- PostgreSQL 容器参数 ----------
POSTGRES_DB=drone_website_server
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-strong-db-password

# ---------- Django 核心与安全 ----------
DJANGO_DEBUG=false
# 生成命令：openssl rand -base64 48
DJANGO_SECRET_KEY=change-me-in-production-at-least-48-chars
DJANGO_ALLOWED_HOSTS=example.com,admin.example.com,127.0.0.1,localhost
PORT=9000
DATABASE_URL=postgresql://app:change-me-strong-db-password@postgres:5432/drone_website_server
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=10000

# ---------- JWT 与 Cookie ----------
JWT_SECRET=change-me-jwt-secret-must-be-at-least-32-characters
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
COOKIE_SECURE=true
TRUST_PROXY=true
CORS_ORIGINS=

# ---------- 生产关闭演示种子与高开销自日志 ----------
SEED_DEMO_USER=false
SEED_DEMO_DATA=false
# 流量较大时建议 false，避免每次 API 请求同步写库
SELF_LOG_ENABLED=false
SERVICE_NAME=drone-website-server
LOG_LEVEL=INFO
LOG_FILE=

# ---------- Gunicorn 进程与优雅停机 ----------
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30
GUNICORN_GRACEFUL_TIMEOUT=15
RUN_MIGRATIONS_ON_START=false

# ---------- 容灾与高并发双通道插槽 ----------
INGEST_RATE_LIMIT=600
# 档位 1（单机基线）：REDIS_URL 留空，INGEST_MODE=direct
# 档位 2/3（开启 --profile ha 后）：取消下面两行注释即可切换为分布式限流 + 异步队列削峰
REDIS_URL=
# REDIS_URL=redis://redis:6379/0
REDIS_TIMEOUT_MS=200
INGEST_MODE=direct
# INGEST_MODE=redis_queue
INGEST_QUEUE_MAXLEN=50000
INGEST_FALLBACK_SAMPLE_RATE=0.2

# ---------- 前端构建参数 ----------
VITE_APP_NAME=AeroApex
VITE_API_BASE_URL=/api
VITE_MONITOR_ENDPOINT=/api
VITE_MONITOR_APP_KEY=
