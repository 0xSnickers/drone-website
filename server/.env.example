DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=*
PORT=9000
# 不设置时回落到本地 sqlite（db.sqlite3），方便零依赖启动
DATABASE_URL=postgresql://app:password@localhost:5432/drone_website_server
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=10000
# 允许跨域的前端地址，逗号分隔；走同源代理时可留空
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
# 生产环境必须改成 32 位以上随机串：openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-dev-only-secret
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
COOKIE_SECURE=false
# 启动时创建演示账号 demo@example.com / password123（admin），生产环境关闭
SEED_DEMO_USER=true
# 开发环境自动创建演示监控项目 pk_demo_web 与模拟监控数据，生产环境关闭
SEED_DEMO_DATA=true
SELF_LOG_ENABLED=true
SERVICE_NAME=drone-website-server
TRUST_PROXY=false
INGEST_RATE_LIMIT=600
# 容灾与扩容插槽：留空时走进程内存限流 + 同步写库；配置后启用分布式限流（超时自动熔断回退）
REDIS_URL=
REDIS_TIMEOUT_MS=200
# direct（默认直写 DB） | redis_queue（写入 Redis 队列，需配合 run_ingest_worker 消费）
INGEST_MODE=direct
INGEST_QUEUE_MAXLEN=50000
INGEST_FALLBACK_SAMPLE_RATE=0.2
LOG_LEVEL=INFO
# 生产容器建议设为空串，统一由 Docker 采集标准输出
LOG_FILE=logs/app.log
