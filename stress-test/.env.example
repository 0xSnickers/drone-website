# ---------- 被测目标地址 ----------
STRESS_WEB_URL=http://localhost:5173
STRESS_ADMIN_URL=http://localhost:5174
STRESS_SERVER_URL=http://localhost:9000

# ---------- 鉴权与监控凭证 ----------
# 用于后端鉴权接口及管理端受保护路由压测（对应后端 SEED_DEMO_USER）
STRESS_ADMIN_EMAIL=demo@example.com
STRESS_ADMIN_PASSWORD=password123
# 监控 SDK 上报压测使用的项目 appKey（留空时自动通过管理接口读取首个项目或回落 pk_demo_web）
STRESS_APP_KEY=pk_demo_web

# ---------- 压测默认档位与行为 ----------
# 预设档位：smoke | l1-baseline | l2-growth | l3-burst | spike
STRESS_PROFILE=l1-baseline
# 压测套件：all | frontend | backend | assets | browser | sdk | api | mixed
STRESS_SUITE=all
# 是否通过 X-Forwarded-For 模拟海量离散访客 IP（配合后端 TRUST_PROXY=true 测试非单 IP 限流上限）
STRESS_SIMULATE_IPS=false

# ---------- 真实浏览器压测配置 ----------
# 驱动选择：auto（优先 Playwright，未安装时自动回落原生 CDP）| playwright | cdp
STRESS_BROWSER_DRIVER=auto
# 自定义 Chrome / Chromium 可执行文件路径（留空则自动探测系统路径）
STRESS_CHROME_BIN=
STRESS_HEADLESS=true

# ---------- 报告输出 ----------
STRESS_REPORT_DIR=reports
